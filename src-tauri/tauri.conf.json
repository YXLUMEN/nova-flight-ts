{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "nova-flight",
  "version": "0.2.19",
  "identifier": "com.lumen.nova-flight",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "removeUnusedCommands": true
  },
  "app": {
    "windows": [
      {
        "title": "Nova Flight",
        "width": 1208,
        "height": 752,
        "minWidth": 771,
        "minHeight": 752,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "zoomHotkeysEnabled": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' asset: http://asset.localhost",
        "connect-src": "'self' ipc: http://ipc.localhost asset: http://asset.localhost ws: wss:",
        "script-src": "'self' 'wasm-unsafe-eval'"
      },
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$RESOURCE/**"
        ]
      },
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi"
    ],
    "resources": {
      "../resources/": "resources/"
    },
    "windows": {
      "webviewInstallMode": {
        "silent": true,
        "type": "downloadBootstrapper"
      },
      "wix": {
        "language": "zh-CN"
      }
    },
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "windows": {
        "installMode": "basicUi"
      },
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY1RTg0MThEQUIwMTVGQjkKUldTNVh3R3JqVUhvWmFLWWU0WkFyUWZFc0lnc0xsZUdFZEtKUllqdnNOelRBZXF4TTE1SXN3TUsK",
      "endpoints": [
        "https://arctic-red-tide.xyz/app/nova-flight/latest.json"
      ]
    }
  }
}
